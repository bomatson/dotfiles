#!/usr/bin/env bash
# Machine-local hooks that install.sh (claude-config) used to append to ~/.bash_profile.

# Secrets exported by ~/src/claude-config/install.sh
[ -f "$HOME/.secrets.env" ] && source "$HOME/.secrets.env"

# asdf >= 0.16 (Go rewrite): shims dir on PATH is all that is needed
export PATH="$HOME/.asdf/shims:$PATH"

# Google Cloud SDK (brew cask gcloud-cli)
[ -f /opt/homebrew/share/google-cloud-sdk/path.bash.inc ] && source /opt/homebrew/share/google-cloud-sdk/path.bash.inc

# fzf keybindings + completion (brew fzf)
[ -f /opt/homebrew/opt/fzf/shell/key-bindings.bash ] && source /opt/homebrew/opt/fzf/shell/key-bindings.bash
[ -f /opt/homebrew/opt/fzf/shell/completion.bash ] && source /opt/homebrew/opt/fzf/shell/completion.bash

# glab (charmbracelet/huh UI) emits true-color escapes that bypass the terminal palette, giving a harsh
# indigo for prompts. With a 16-color TERM it downgrades to ANSI colors, which the iTerm preset controls.
alias glab='COLORTERM= TERM=xterm glab'
